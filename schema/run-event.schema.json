  "$defs": {
    "DataRunCreated": {
      "type": "object",
      "required": [
        "snapshot_ref",
        "graph_id",
        "branch",
        "graph_version",
        "registry_hash",
        "inputs_ref",
        "budget"
      ],
      "additionalProperties": false,
      "description": "C.06.02 §2（P 级）",
      "properties": {
        "snapshot_ref": {
          "$ref": "common.schema.json#/$defs/WsRef"
        },
        "graph_id": {
          "$ref": "common.schema.json#/$defs/Ulid"
        },
        "branch": {},
        "graph_version": {
          "type": "integer",
          "minimum": 0
        },
        "registry_hash": {},
        "inputs_ref": {
          "$ref": "common.schema.json#/$defs/WsRef"
        },
        "budget": {}
      }
    },
    "DataRunStatus": {
      "type": "object",
      "required": [
        "from",
        "to",
        "cause"
      ],
      "additionalProperties": false,
      "description": "C.06.02 §2；to 取值见 C.07 §2（P 级）",
      "properties": {
        "from": {
          "$ref": "common.schema.json#/$defs/RunStatus"
        },
        "to": {
          "$ref": "common.schema.json#/$defs/RunStatus"
        },
        "cause": {},
        "at_safepoint": {
          "type": "boolean",
          "default": false
        },
        "cost": {}
      }
    },
    "DataRunCancelRequested": {
      "type": "object",
      "required": [
        "by",
        "reason"
      ],
      "additionalProperties": false,
      "description": "C.06.02 §2（P 级）",
      "properties": {
        "by": {},
        "reason": {
          "enum": [
            "user",
            "estop",
            "budget",
            "timeout"
          ]
        }
      }
    },
    "DataRunGraphSwapped": {
      "type": "object",
      "required": [
        "from_version",
        "to_version",
        "op_ids",
        "scope_path",
        "source"
      ],
      "additionalProperties": false,
      "description": "C.06.02 §2；安全点改图（P 级）",
      "properties": {
        "from_version": {
          "type": "integer",
          "minimum": 0
        },
        "to_version": {
          "type": "integer",
          "minimum": 0
        },
        "op_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/Ulid"
          }
        },
        "scope_path": {},
        "at_round": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "enum": [
            "user",
            "model"
          ]
        }
      }
    },
    "DataEngineIllegalTransition": {
      "type": "object",
      "required": [
        "from",
        "to",
        "cause"
      ],
      "additionalProperties": false,
      "description": "C.06.02 §2；状态机拒绝了一次转换（P 级）",
      "properties": {
        "from": {},
        "to": {},
        "cause": {},
        "loc": {
          "$ref": "common.schema.json#/$defs/Loc"
        }
      }
    },
    "DataNodeState": {
      "type": "object",
      "required": [
        "from",
        "to",
        "attempt",
        "cause"
      ],
      "additionalProperties": false,
      "description": "C.06.02 §3；唯一的节点状态事件，按 to 附加的字段都可选（C.06.01-R7）（P 级）",
      "properties": {
        "from": {
          "$ref": "common.schema.json#/$defs/NodeState"
        },
        "to": {
          "$ref": "common.schema.json#/$defs/NodeState"
        },
        "attempt": {
          "type": "integer",
          "minimum": 0
        },
        "cause": {},
        "error": {
          "$ref": "#/$defs/NodeError"
        },
        "idem_key": {},
        "backoff_ms": {
          "type": "integer",
          "minimum": 0
        },
        "inputs_ref": {
          "$ref": "common.schema.json#/$defs/WsRef"
        },
        "approval_id": {
          "$ref": "common.schema.json#/$defs/Ulid"
        },
        "reason": {},
        "outputs_ref": {
          "$ref": "common.schema.json#/$defs/WsRef"
        },
        "active_outs": {},
        "cost": {},
        "partial": {
          "type": "boolean",
          "default": false
        },
        "cache_key": {}
      },
      "allOf": [
        {
          "if": {
            "required": [
              "to"
            ],
            "properties": {
              "to": {
                "const": "queued"
              }
            }
          },
          "then": {
            "properties": {
              "cause": {
                "enum": [
                  "ready",
                  "retry",
                  "resume",
                  "manual_retry"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "to"
            ],
            "properties": {
              "to": {
                "const": "cancelled"
              }
            }
          },
          "then": {
            "properties": {
              "cause": {
                "enum": [
                  "user",
                  "estop",
                  "k_of_n_satisfied",
                  "first_satisfied",
                  "timeout",
                  "budget"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "to"
            ],
            "properties": {
              "to": {
                "const": "skipped"
              }
            }
          },
          "then": {
            "properties": {
              "cause": {
                "enum": [
                  "inactive_edge",
                  "upstream_skipped"
                ]
              }
            }
          }
        }
      ]
    },
    "DataNodeProgress": {
      "type": "object",
      "required": [],
      "additionalProperties": false,
      "description": "C.06.02 §3（S 级）",
      "properties": {
        "pct": {
          "type": "number",
          "minimum": 0,
