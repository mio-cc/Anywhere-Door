{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anydoor.local/schema/recipe.schema.json",
  "x-version": "1.0",
  "title": "配方（C.13.01）",
  "type": "object",
  "required": [
    "name",
    "version",
    "sections",
    "budget",
    "on_overflow"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 40,
      "description": "如 执行者配方"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "引用写作 执行者配方@1"
    },
    "description": {
      "type": "string"
    },
    "inputs": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z_][a-z0-9_]*$",
        "not": {
          "const": "exp"
        }
      },
      "additionalProperties": {
        "$ref": "types.schema.json#/$defs/TypeRef"
      },
      "description": "来源名 → 数据类型；装配时按类型把 in 上的输入分给各来源（R4）"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Section"
      }
    },
    "exclude": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(type|path):.+$"
      },
      "description": "排除的内容：type:方案（按类型）、path:*.reasoning（按字段路径）"
    },
    "budget": {
      "type": "object",
      "required": [
        "ratio"
      ],
      "additionalProperties": false,
      "properties": {
        "ratio": {
          "type": "number",
          "minimum": 0,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "占模型窗口的比例，必须大于 0（R3）"
        },
        "max_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "上下文装配节点的 budget 参数不能超过它（R3）"
        }
      }
    },
    "on_overflow": {
      "enum": [
        "pointer",
        "summarize",
        "truncate",
        "reject"
      ]
    }
  },
  "$defs": {
    "Section": {
      "type": "object",
      "required": [
        "name",
        "from"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 20,
          "description": "任务 / 约束 / 参考资料 / 差距报告 / 经验"
        },
        "from": {
          "type": "string",
          "description": "输入来源：in（全部输入）、in[0]、in.task.instruction（字段路径）"
        },
        "transform": {
          "type": "string",
          "pattern": "^(as_is|pointer|summary|top_k\\(\\d+\\)|fields\\([a-z_,]+\\)|template\\(.+\\))$",
          "default": "as_is"
        },
        "budget": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0,
          "description": "本段占总预算的比例；0 = 不单独限制"
        },
        "required": {
          "type": "boolean",
          "default": false,
          "description": "必需段被裁掉时直接失败（on_overflow 不适用）"
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9,
          "default": 5,
          "description": "超预算时先裁优先级低的（数字大 = 低）"
        },
        "format": {
          "enum": [
            "markdown",
            "yaml",
            "bullets"
          ],
          "default": "markdown"
        },
        "var": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$",
          "description": "这一段渲染后的文字同时放进上下文包的 vars（R6）"
        }
      }
    }
  }
}
