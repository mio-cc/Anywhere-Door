    {"name": "上下文包接任意", "src": "上下文包@1", "dst": "任意", "src_node": "上下文装配", "want": {"ok": true, "rule": "C0"}},
    {"name": "任意接具体类型", "src": "任意", "dst": "方案@1", "want": {"ok": false, "rule": "C1", "reason": "任意类型只能接到「任意」端口。先接一个设置了输出类型的 Agent 来转换"}},
    {"name": "任意接列表", "src": "任意", "dst": "列表[方案@1]", "want": {"ok": false, "rule": "C1", "reason": "任意类型只能接到「任意」端口。先接一个设置了输出类型的 Agent 来转换"}},
    {"name": "任意接系统类型（C1 先于 C2）", "src": "任意", "dst": "上下文包@1", "want": {"ok": false, "rule": "C1", "reason": "任意类型只能接到「任意」端口。先接一个设置了输出类型的 Agent 来转换"}},
    {"name": "资源接 context（INV-07）", "src": "资源引用@1", "dst": "上下文包@1", "src_node": "资源", "want": {"ok": false, "rule": "C2", "reason": "上下文包只能来自上下文装配节点"}},
    {"name": "Agent 输出接上下文包", "src": "方案@1", "dst": "上下文包@1", "src_node": "Agent", "want": {"ok": false, "rule": "C2", "reason": "上下文包只能来自上下文装配节点"}},
    {"name": "上下文包不是装配节点产出的", "src": "上下文包@1", "dst": "上下文包@1", "src_node": "Agent", "want": {"ok": false, "rule": "C2", "reason": "上下文包只能来自上下文装配节点"}},
    {"name": "执行结果接工具端点", "src": "执行结果@1", "dst": "工具端点@1", "src_node": "Agent", "want": {"ok": false, "rule": "C2", "reason": "工具端点只能来自工具节点"}},
