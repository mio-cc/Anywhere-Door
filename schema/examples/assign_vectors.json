    {"name": "价格表接执行结果", "src": "价格表@1", "dst": "执行结果@1", "want": {"ok": true, "rule": "C5"}},
    {"name": "两层继承", "src": "加急任务卡@1", "dst": "任务@1", "want": {"ok": true, "rule": "C5"}},
    {"name": "两层继承（中间一层）", "src": "加急任务卡@1", "dst": "任务卡@1", "want": {"ok": true, "rule": "C5"}},
    {"name": "父类型接子类型", "src": "任务@1", "dst": "任务卡@1", "want": {"ok": false, "rule": "C6", "reason": "父类型不能接到子类型端口"}},
    {"name": "执行结果接价格表", "src": "执行结果@1", "dst": "价格表@1", "want": {"ok": false, "rule": "C6", "reason": "父类型不能接到子类型端口"}},
    {"name": "祖先接孙类型", "src": "任务@1", "dst": "加急任务卡@1", "want": {"ok": false, "rule": "C6", "reason": "父类型不能接到子类型端口"}},
    {"name": "列表自动展开", "src": "列表[执行结果@1]", "dst": "执行结果@1", "want": {"ok": true, "rule": "C7", "expand": true}},
    {"name": "子类型列表展开接父类型", "src": "列表[任务卡@1]", "dst": "任务@1", "want": {"ok": true, "rule": "C7", "expand": true}},
    {"name": "次版本列表展开", "src": "列表[判定@1.1]", "dst": "判定@1", "want": {"ok": true, "rule": "C7", "expand": true}},
    {"name": "单值接列表", "src": "方案@1", "dst": "列表[方案@1]", "want": {"ok": false, "rule": "C8", "reason": "单个值不能接到列表端口，中间加一个汇合节点"}},
    {"name": "执行结果接列表", "src": "执行结果@1", "dst": "列表[执行结果@1]", "want": {"ok": false, "rule": "C8", "reason": "单个值不能接到列表端口，中间加一个汇合节点"}},
    {"name": "子类型单值接父类型列表", "src": "任务卡@1", "dst": "列表[任务@1]", "want": {"ok": false, "rule": "C8", "reason": "单个值不能接到列表端口，中间加一个汇合节点"}},
    {"name": "列表次版本", "src": "列表[方案@1.2]", "dst": "列表[方案@1]", "want": {"ok": true, "rule": "C9"}},
    {"name": "子类型列表接父类型列表", "src": "列表[任务卡@1]", "dst": "列表[任务@1]", "want": {"ok": true, "rule": "C9"}},
    {"name": "父类型列表接子类型列表", "src": "列表[任务@1]", "dst": "列表[任务卡@1]", "want": {"ok": false, "rule": "C9", "reason": "父类型不能接到子类型端口"}},
    {"name": "列表元素有迁移", "src": "列表[方案@1]", "dst": "列表[方案@2]", "want": {"ok": true, "rule": "C9", "migrate": "方案@1→2"}},
    {"name": "任意列表接具体列表", "src": "列表[任意]", "dst": "列表[方案@1]", "want": {"ok": false, "rule": "C9", "reason": "任意类型只能接到「任意」端口。先接一个设置了输出类型的 Agent 来转换"}},
    {"name": "列表元素不同名", "src": "列表[方案@1]", "dst": "列表[判定@1]", "want": {"ok": false, "rule": "C9", "reason": "方案@1 不能接到 判定@1"}},
    {"name": "具体列表接任意列表", "src": "列表[方案@1]", "dst": "列表[任意]", "want": {"ok": true, "rule": "C9"}},
    {"name": "不同名", "src": "方案@1", "dst": "判定@1", "want": {"ok": false, "rule": "C10", "reason": "方案@1 不能接到 判定@1"}},
    {"name": "评审意见接方案", "src": "评审意见@1", "dst": "方案@1", "want": {"ok": false, "rule": "C10", "reason": "评审意见@1 不能接到 方案@1"}},
    {"name": "判定接任务", "src": "判定@1", "dst": "任务@1", "want": {"ok": false, "rule": "C10", "reason": "判定@1 不能接到 任务@1"}},
    {"name": "下游是容器节点不展开", "src": "列表[执行结果@1]", "dst": "执行结果@1", "dst_container": true, "want": {"ok": false, "rule": "C10", "reason": "列表[执行结果@1] 不能接到 执行结果@1"}},
    {"name": "列表元素接不上", "src": "列表[方案@1]", "dst": "判定@1", "want": {"ok": false, "rule": "C10", "reason": "列表[方案@1] 不能接到 判定@1"}},
    {"name": "系统类型接业务类型", "src": "上下文包@1", "dst": "方案@1", "src_node": "上下文装配", "want": {"ok": false, "rule": "C10", "reason": "上下文包@1 不能接到 方案@1"}}
  ]
