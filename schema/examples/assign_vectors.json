    {"name": "方案", "major": 1, "minor": 2},
    {"name": "方案", "major": 2, "minor": 0, "migrate_from": ["1"]},
    {"name": "目标", "major": 1, "minor": 0},
    {"name": "目标", "major": 2, "minor": 0},
    {"name": "判定", "major": 1, "minor": 1},
