{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anydoor.local/schema/nodedef.schema.json",
  "x-version": "1.0",
  "title": "节点定义 NodeDef（C.03）",
  "type": "object",
  "required": [
    "name",
    "version",
    "kind",
    "category",
    "impl",
    "ports",
    "params"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "kind": {
      "enum": [
        "atomic",
        "extension"
      ]
    },
    "category": {
      "enum": [
        "资源",
        "智能体",
        "状态",
        "工具",
        "拓扑",
        "聚合",
        "控制",
        "人工",
        "边界",
        "扩展"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 200
    },
    "icon": {
      "type": "string",
      "description": "图标名，取自 U.08 图标表；扩展节点缺省为 扩展"
    },
    "impl": {
      "$ref": "#/$defs/Impl"
    },
    "ports": {
      "type": "object",
      "required": [
        "inputs",
        "outputs"
      ],
      "additionalProperties": false,
      "properties": {
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/PortDef"
          },
          "propertyNames": {
            "pattern": "^[a-z_][a-z0-9_]*$"
          }
        },
        "outputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/PortDef"
          },
          "propertyNames": {
            "pattern": "^[a-z_][a-z0-9_]*$"
          }
        }
      }
    },
    "params": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ParamDef"
      },
      "propertyNames": {
        "pattern": "^[a-z_][a-z0-9_]*$"
      }
    },
    "type_vars": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "pattern": "^[A-Z]$"
      },
      "description": "类型变量的来源，如 {\"T\": \"param:output_schema\"}，见 C.04.03"
    },
    "container": {
      "enum": [
        "none",
        "required",
        "one_of"
      ],
      "default": "none",
      "description": "与 container_rules.yaml 一致，见 C.02.04"
    },
    "kernel_rules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "内核强制规则的编号，只用于展示，如 INV-07"
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dynamic_ports": {
      "$ref": "#/$defs/DynamicPorts"
    }
  },
  "$defs": {
    "PortDef": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "description": "端口定义（C.03.01 §4）",
      "properties": {
        "type": {
          "$ref": "types.schema.json#/$defs/TypeRef"
        },
        "category": {
          "$ref": "types.schema.json#/$defs/Category",
          "description": "显示类别；缺省由 type 推出（C.04.01）"
        },
        "label": {
          "type": "string",
          "maxLength": 20
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "multi": {
          "type": "boolean",
          "default": false,
          "description": "允许多条连线，见 C.04.04"
        },
        "dynamic": {
          "type": "boolean",
          "default": false,
          "description": "动态插口 in[0]、in[1]…"
        },
        "stream": {
          "type": "boolean",
          "default": false,
          "description": "支持流式片段，见 E.16"
        },
        "lock": {
          "enum": [
            "none",
            "kernel"
          ],
          "default": "none"
        }
      },
      "not": {
        "required": [
          "multi",
          "dynamic"
        ],
        "properties": {
          "multi": {
            "const": true
          },
          "dynamic": {
            "const": true
          }
        },
        "description": "C.04.04-R4：multi 和 dynamic 不能同时为 true"
      }
    },
    "DynamicPorts": {
      "type": "object",
      "required": [
        "from_param"
      ],
      "additionalProperties": false,
      "description": "从一个参数生成输入端口（C.03.05-R4）：文本参数按 {{变量}} 抽取；schema_from 对象参数按 C.03.02 §5 每个子参数一个",
      "properties": {
        "from_param": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$"
        },
        "type": {
          "$ref": "types.schema.json#/$defs/TypeRef",
          "default": "任意",
          "description": "只用于文本变量；schema_from 展开的端口一律 任意"
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32,
          "default": 8
        }
      }
    },
    "Impl": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": true,
      "description": "执行方式（C.03.01 §4、C.03.04 §3）。按 type 判别：字段由对应的 Impl* 定义封闭；判别用 if/then 而不是 oneOf，type 写错时只在 /type 报一处错",
      "properties": {
        "type": {
          "enum": [
            "builtin",
            "prompt",
            "http",
            "mcp",
            "subgraph"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "builtin"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/ImplBuiltin"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "prompt"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/ImplPrompt"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "http"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/ImplHttp"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "mcp"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/ImplMcp"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "subgraph"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/ImplSubgraph"
          }
        }
      ]
    },
    "ImplBuiltin": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "description": "Go 执行器：原子节点，以及编译进程序的编程式扩展节点（C.03.04-R6）",
      "properties": {
        "type": {
          "const": "builtin"
        },
        "entry": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "description": "编程式扩展节点的注册名；原子节点不写"
        }
      }
    },
    "ImplPrompt": {
      "type": "object",
      "required": [
        "type",
        "output_schema"
      ],
      "additionalProperties": false,
      "description": "一次模型调用，展开为 上下文装配 → Agent（C.03.04 §3.1）",
      "properties": {
        "type": {
          "const": "prompt"
        },
        "rolecard": {
          "type": "string",
          "pattern": "^[^@\\s]+@(\\d+|latest)$",
          "description": "角色卡（C.13.02）"
        },
        "recipe": {
          "type": "string",
          "pattern": "^[^@\\s]+@\\d+$",
          "description": "配方（C.13.01）；不写时用单输入直传的内置配方"
        },
        "template": {
          "type": "string",
          "maxLength": 20000,
          "description": "没有角色卡时用的提示词模板，变量写 {{参数名}}、{{inputs.端口名}}；不能引用密钥（C.03.04-R4）"
        },
        "output_schema": {
          "$ref": "types.schema.json#/$defs/TypeRef"
        }
      }
    },
    "ImplHttp": {
      "type": "object",
      "required": [
        "type",
        "risk",
        "method",
        "url"
      ],
      "additionalProperties": false,
      "description": "一次 HTTP 调用，展开为一个工具节点（C.03.04 §3.2）",
      "properties": {
        "type": {
          "const": "http"
        },
        "risk": {
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3"
          ],
          "description": "风险等级（S.04）"
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "url": {
          "type": "string",
          "pattern": "^https?://",
          "description": "可以用 {{参数名}}；查询参数里可以用 {{secret:密钥名}}"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "可以用 {{secret:密钥名}}（C.03.04-R4）"
        },
        "body": {
          "description": "请求体，任意 JSON；null 表示没有"
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "map": {
              "type": "string",
              "description": "JSONPath，取出的值作为 result"
            },
            "result_type": {
              "$ref": "types.schema.json#/$defs/TypeRef"
            }
          }
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        }
      },
      "if": {
        "required": [
          "method"
        ],
        "properties": {
          "method": {
            "enum": [
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "risk": {
            "enum": [
              "L2",
              "L3"
            ],
            "description": "C.03.04-R5：会改动外部数据的方法最低 L2"
          }
        }
      }
    },
    "ImplMcp": {
      "type": "object",
      "required": [
        "type",
        "server",
        "tool"
      ],
      "additionalProperties": false,
      "description": "调用一个 MCP 工具，展开为一个工具节点（C.03.04 §3.3）",
      "properties": {
        "type": {
          "const": "mcp"
        },
        "server": {
          "type": "string",
          "minLength": 1,
          "description": "设置里配置的 MCP 服务器名"
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "risk": {
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3"
          ],
          "description": "必须不低于服务器声明的风险等级；服务器没声明时必填，由加载时检查（E.04）"
        },
        "args": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "参数映射，值可以引用 {{参数名}}、{{inputs.端口名}}"
        }
      }
    },
    "ImplSubgraph": {
      "type": "object",
      "required": [
        "type",
        "ref"
      ],
      "additionalProperties": false,
      "description": "把子图库里的一段子图打包成节点类型，展开为一个子图引用节点，pin 固定为 snapshot（C.03.04 §3.4）",
      "properties": {
        "type": {
          "const": "subgraph"
        },
        "ref": {
          "type": "object",
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[^@/]{1,60}$"
            },
            "version": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$"
            }
          }
        },
        "expose": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z_][a-z0-9_]*$"
          },
          "description": "节点参数名 → 子图内部的参数",
          "additionalProperties": {
            "type": "object",
            "required": [
              "node",
              "param"
            ],
            "additionalProperties": false,
            "properties": {
              "node": {
                "$ref": "common.schema.json#/$defs/Ulid"
              },
              "param": {
                "type": "string",
                "pattern": "^[a-z_][a-z0-9_]*$"
              }
            }
          }
        }
      }
    },
    "ParamDef": {
      "type": "object",
      "required": [
        "type",
        "label"
      ],
      "additionalProperties": false,
      "description": "参数描述（C.03.02 §3）",
      "properties": {
        "type": {
          "enum": [
            "integer",
            "number",
            "string",
            "text",
            "boolean",
            "enum",
            "type_ref",
            "recipe_ref",
            "rolecard_ref",
            "model_ref",
            "tool_ref",
            "expr",
            "object"
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 20
        },
        "help": {
          "type": "string",
          "maxLength": 200
        },
        "default": {},
        "enum": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number"
            ]
          },
          "minItems": 1
        },
        "enum_labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "枚举值 → 界面显示名"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "step": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "maxLength": 8,
          "description": "显示单位，如 s、%"
        },
        "max_length": {
          "type": "integer"
        },
        "schema": {
          "type": "object",
          "x-open": true,
          "description": "type=object 时的 JSON Schema"
        },
        "schema_from": {
          "type": "string",
          "pattern": "^param:[a-z_][a-z0-9_]*$",
          "description": "type=object 时：结构取自另一个参数所选对象的入参 schema，如 param:tool，按 C.03.02 §5 展开"
        },
        "ui": {
          "$ref": "#/$defs/ParamUI",
          "description": "界面提示：分组、控件、接线、条件显示（C.03.05）"
        },
        "promotable": {
          "type": "boolean",
          "default": true
        },
        "lock": {
          "enum": [
            "none",
            "def",
            "kernel"
          ],
          "default": "none"
        },
        "secret": {
          "type": "boolean",
          "default": false,
          "description": "只能填密钥名，不能填密钥值（S.03）"
        }
      },
      "allOf": [
        {
          "description": "C.03.02-R3：secret 参数只能是 string",
          "if": {
            "required": [
              "secret"
            ],
            "properties": {
              "secret": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "type": {
                "const": "string"
              }
            }
          }
        },
        {
          "description": "C.03.02-R6：schema_from 只用于 object 参数",
          "if": {
            "required": [
              "schema_from"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "object"
              }
            }
          }
        }
      ]
    },
    "ParamUI": {
      "type": "object",
      "additionalProperties": false,
      "description": "参数的界面提示（C.03.05 §4）；只影响显示，不进入执行（C.03.05-R6）",
      "properties": {
        "group": {
          "enum": [
            "常用",
            "高级"
          ],
          "default": "高级",
          "description": "常用：显示在节点上；高级：只在右栏属性里"
        },
        "order": {
          "type": "integer",
          "description": "同组内排序，小的在前"
        },
        "widget": {
          "enum": [
            "auto",
            "input",
            "textarea",
            "stepper",
            "slider",
            "segmented",
            "select",
            "switch",
            "picker",
            "code",
            "model",
            "rolecard",
            "connection"
          ],
          "default": "auto",
          "description": "auto 时按 C.03.02 §4 推出（schema/builtin/widget_map.yaml）"
        },
        "rows": {
          "type": "integer",
          "minimum": 2,
          "maximum": 12,
          "description": "textarea 的默认行数；节点上固定 3 行，右栏可拉高"
        },
        "placeholder": {
          "type": "string",
          "maxLength": 80
        },
        "bind": {
          "type": "string",
          "description": "同名输入端口。端口有连线时，参数显示为『由上游「X」提供』，运行时用上游的值"
        },
        "show_if": {
          "type": "string",
          "description": "条件表达式（与分支节点同一套），为假时隐藏，如 kind == '提示词'"
        },
        "connection_type": {
          "type": "string",
          "description": "widget=connection 时可选的连接类型（C.16）"
        }
      }
    }
  }
}
