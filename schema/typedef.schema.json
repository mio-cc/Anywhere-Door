{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anydoor.local/schema/typedef.schema.json",
  "x-version": "1.0",
  "title": "业务数据类型声明（C.13.03）",
  "type": "object",
  "required": [
    "name",
    "major",
    "minor"
  ],
  "oneOf": [
    {
      "required": [
        "fields"
      ]
    },
    {
      "required": [
        "scalar"
      ]
    }
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[^@\\[\\]/\\s]{1,30}$"
    },
    "major": {
      "type": "integer",
      "minimum": 1
    },
    "minor": {
      "type": "integer",
      "minimum": 0
    },
    "description": {
      "type": "string",
      "maxLength": 300
    },
    "extends": {
      "$ref": "types.schema.json#/$defs/TypeRef",
      "description": "继承的父类型，子类型可以接到父类型端口（C.04.02 C5）"
    },
    "category": {
      "$ref": "types.schema.json#/$defs/Category",
      "default": "gen",
      "description": "业务类型只能是 gen"
    },
    "system": {
      "type": "boolean",
      "default": false,
      "description": "系统类型（C.04.01 §4）：只有内置，扩展包不能声明"
    },
    "producer": {
      "$ref": "graph.schema.json#/$defs/NodeTypeRef",
      "description": "只能由这种节点产出（C.04.02 C2）；只用于系统类型"
    },
    "scalar": {
      "enum": [
        "string",
        "integer",
        "number",
        "boolean"
      ],
      "description": "标量类型（如 整数@1）；写了 scalar 就不写 fields"
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Field"
      }
    },
    "migrate_from": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "旧主版本 → 迁移表达式（expr-lang），如 {\"1\": \"{title: v.name, ...v}\"}"
    }
  },
  "$defs": {
    "Field": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$"
        },
        "type": {
          "type": "string",
          "description": "string | integer | number | boolean | object | TypeRef | 列表[…]；object 和 列表[object] 用 fields 写成员"
        },
        "label": {
          "type": "string",
          "maxLength": 20
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "inherit": {
          "type": "boolean",
          "default": false,
          "description": "沿数据流向下游强制透传，配方不能排除（E.13.06）"
        },
        "max_chars": {
          "type": "integer",
          "minimum": 1
        },
        "enum": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "readonly_except": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "写入账本时只有这些节点标签能改"
        },
        "append_only": {
          "type": "boolean",
          "default": false
        },
        "require_reason": {
          "type": "boolean",
          "default": false
        },
        "since_minor": {
          "type": "integer",
          "minimum": 0,
          "description": "第几个次版本加入的字段"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Field"
          },
          "description": "type 为 object 或 列表[object] 时的成员字段"
        }
      }
    }
  }
}
